{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Code History Viewer",
  "version": "1.27.0",
  "identifier": "com.claude.history-viewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "just vite-dev",
    "beforeBuildCommand": "just frontend-build"
  },
  "app": {
    "windows": [
      {
        "titleBarStyle": "Overlay",
        "label": "main",
        "title": "",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "focus": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; connect-src 'self' https://api.github.com https://github.com https://*.githubusercontent.com https://fonts.googleapis.com https://fonts.gstatic.com; font-src 'self' data: https://fonts.gstatic.com; frame-ancestors 'none'",
      "capabilities": [
        "default"
      ]
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/minju-kim98/claude-code-history-viewer-fork/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExQjAwNzU0Q0U5MkRFNTIKUldSUzNwTE9WQWV3b1hZVmNVVmtLWGpPTVdaeFk2bm1TQm5TUnN1eUE1cmhLZklFclh2MVZ1bGMK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": null,
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.13"
    }
  }
}
